<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8FC">


    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="55dp"
        android:layout_height="60dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back"
        android:padding="16dp"
        android:src="@drawable/back_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#172B4D" />


    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:text="Add New Document"
        android:textColor="#172B4D"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="22dp">


            <TextView
                android:id="@+id/tvDocumentNameLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Document Name"
                android:textColor="#172B4D"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <EditText
                android:id="@+id/etDocumentName"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:hint="Enter document name"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#172B4D"
                android:textColorHint="#8A94A6"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/tvDocumentNameLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <TextView
                android:id="@+id/tvWardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Ward / Department"
                android:textColor="#172B4D"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/etDocumentName"
                app:layout_constraintStart_toStartOf="parent" />


            <EditText
                android:id="@+id/etWard"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:hint="Enter ward or department"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#172B4D"
                android:textColorHint="#8A94A6"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/tvWardLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <TextView
                android:id="@+id/tvStorageLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Storage Location"
                android:textColor="#172B4D"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/etWard"
                app:layout_constraintStart_toStartOf="parent" />


            <EditText
                android:id="@+id/etStorage"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:hint="Drawer, Shelf or Cupboard"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#172B4D"
                android:textColorHint="#8A94A6"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/tvStorageLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <TextView
                android:id="@+id/tvCategoryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Category"
                android:textColor="#172B4D"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/etStorage"
                app:layout_constraintStart_toStartOf="parent" />


            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvCategoryLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <TextView
                android:id="@+id/tvDescriptionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Description (Optional)"
                android:textColor="#172B4D"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/spinnerCategory"
                app:layout_constraintStart_toStartOf="parent" />


            <EditText
                android:id="@+id/etDescription"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:gravity="top|start"
                android:hint="Add additional information..."
                android:padding="16dp"
                android:textColor="#172B4D"
                android:textColorHint="#8A94A6"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/tvDescriptionLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <TextView
                android:id="@+id/tvLastSeenLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Last Seen"
                android:textColor="#172B4D"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/etDescription"
                app:layout_constraintStart_toStartOf="parent" />


            <EditText
                android:id="@+id/etLastSeen"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:hint="Example: Today, 10:30 AM"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#172B4D"
                android:textColorHint="#8A94A6"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/tvLastSeenLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <!-- SAVE DOCUMENT BUTTON -->

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="#1E5DB7"
                android:text="SAVE DOCUMENT"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/etLastSeen"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>